{
  "name": "octobook-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "prepare:logo": "node scripts/prepare_logo.mjs",
    "compress:images": "node scripts/compress_images.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tabler/icons-react": "^3.46.0",
    "clsx": "^2.1.1",
    "next": "16.3.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "postcss": "^8.5",
    "prisma": "^6.19.3",
    "sharp": "^0.34.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.4"
  }
}
