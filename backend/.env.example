# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Public URLs (used in redirects / frontend handoff)
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database
# Docker Compose: postgresql://octokiss:octokiss@localhost:5432/octokiss?schema=public
# Local Homebrew Postgres example: postgresql://YOUR_USER@localhost:5432/octokiss?schema=public
DATABASE_URL=postgresql://octokiss:octokiss@localhost:5432/octokiss?schema=public

# Webinar
REGISTRATION_FEE_KWD=40.000

# AI Collection (paste bearer token from their email)
AI_COLLECTION_BASE_URL=https://ai-collection.com/businessapi
AI_COLLECTION_BEARER_TOKEN=
# 1 = KNET, 2 = Visa/Mastercard
AI_COLLECTION_DEFAULT_GATEWAY_ID=1
